{
  "manifest_version": 3,
  "name": "ReconKit — Security Research Toolkit",
  "short_name": "ReconKit",
  "version": "1.0.0",
  "description": "A privacy-first toolkit for security researchers and developers: crypto & text utilities, passive website analysis, OSINT lookups, DNS/ASN intelligence. All core processing happens on your machine.",
  "author": "ZishanAdThandar",
  "homepage_url": "https://github.com/ZishanAdThandar/reconkit",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "activeTab",
    "contextMenus",
    "storage",
    "tabs",
    "clipboardWrite"
  ],
  "optional_permissions": [
    "cookies"
  ],
  "host_permissions": [
    "https://crt.sh/*",
    "http://crt.sh/*",
    "https://dns.google/*",
    "https://cloudflare-dns.com/*",
    "https://ipinfo.io/*"
  ],
  "background": {
    "scripts": [
      "background/background.js",
      "background/context-menu.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*",
        "file://*/*"
      ],
      "js": [
        "lib/lib-core.js",
        "lib/detect.js",
        "content/sniffer.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "app/app.html",
    "default_title": "ReconKit",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Open the ReconKit popup"
    },
    "reconkit-open-analyzer": {
      "suggested_key": {
        "default": "Alt+Shift+A"
      },
      "description": "Analyze the current website"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "reconkit@zishanhack.com",
      "strict_min_version": "115.0"
    }
  }
}